---
import '../styles/global.css';
import Search from '../components/Search.astro';
/** crumbs: 画面のパンくずと同じ並び（BreadcrumbList の構造化データに使う）/ jsonld: ページ固有の構造化データ */
interface Props {
  title: string; description?: string; active?: 'home' | 'compare' | 'games' | 'magic'; path?: string; hideSearch?: boolean;
  crumbs?: { name: string; path: string }[]; jsonld?: Record<string, unknown>[]; noindex?: boolean;
}
const { title, description = 'あのゲームの「あの魔法」、別のRPGでは何て呼ぶ？ 同じ役割の魔法を作品横断で比較する辞典。', active, path, hideSearch = false, crumbs, jsonld = [], noindex = false } = Astro.props;
const canonical = path && Astro.site ? new URL(path, Astro.site).href : undefined;
// OGP 画像はサイト共通の1枚（scripts/make-og.mjs で生成）。SNS は絶対URLが必要
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).href;
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
const ld = [
  ...(crumbs?.length
    ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })) }]
    : []),
  ...jsonld,
];
const nav = [
  { key: 'home', label: 'トップ', short: 'トップ', glyph: '辞', href: '/' },
  { key: 'compare', label: '横断比較', short: '比較', glyph: '較', href: '/element/fire' },
  { key: 'games', label: '作品一覧', short: '作品', glyph: '作', href: '/game' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ece2ca" />
    <meta name="google-site-verification" content="xtgTp9GaqCZJbzQf_eNLFUsGESCEf6iWNv42d084ivY" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content="RPG魔法の言い換え辞典" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=IM+Fell+English+SC&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Shippori+Mincho+B1:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Google tag (gtag.js)。is:inline で Astro の加工を避け、そのまま出力する -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SKPG3ST0T5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SKPG3ST0T5');
    </script>
  </head>
  <body>
    <header class="hdr">
      <div class="wrap hdr-in">
        <a class="logo" href="/"><span class="seal">魔</span><span>RPG魔法の言い換え辞典</span></a>
        <div class="hdr-sp"></div>
        {!hideSearch && <Search />}
        <nav class="gnav" aria-label="メイン">
          {nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
          <a href="#" data-random>ランダム</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="ftr">
      <div class="wrap"><strong>RPG魔法の言い換え辞典</strong><span>魔法名は各作品の日本語版表記に準拠</span><a href="/about">このサイトについて・データの集め方</a></div>
    </footer>
    <nav class="tabbar" aria-label="メイン">
      {nav.map((n) => <a href={n.href} aria-current={active === n.key || (n.key === 'compare' && active === 'magic') ? 'page' : undefined}><b>{n.glyph}</b>{n.short}</a>)}
      <a href="#" data-random><b>運</b>ランダム</a>
    </nav>

    <script>import '../scripts/site.ts';</script>
  </body>
</html>
