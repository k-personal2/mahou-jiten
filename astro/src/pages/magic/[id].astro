---
import Base from '../../layouts/Base.astro';
import Chapter from '../../components/Chapter.astro';
import Chain from '../../components/Chain.astro';
import BuyBox from '../../components/BuyBox.astro';
import storiesData from '../../data/stories.json';
import {
  PAGE_MAGICS, SYSTEMS, NAMING, groupOf, appearancesOf, gameById, elById, fxById, chainOfMagic, kindName, titleOf, subOf, elnOf, leadParts,
  buildGroups, compareRows, firstNames, tone, markStyle, magicUrl, systemUrl, compareUrl, type Magic,
} from '../../lib/dict';

export function getStaticPaths() {
  return PAGE_MAGICS.map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Magic };
const G = gameById[m.game], E = m.el ? elById[m.el] : null, F = fxById[m.fx], S = SYSTEMS[m.game];
const ch = chainOfMagic(m), idx = ch.findIndex((c) => c.id === m.id);
const kn = kindName(m.fx, m.kind);
const eln = elnOf(m.game, m.el);
const cmpTitle = titleOf(m.el, m.fx), cmpHref = compareUrl(m.el, m.fx);
const lead = leadParts(m);
const sysName = G.sys === 'なし' ? '魔法' : G.sys;
// 同じ作品に同名の魔法が複数あるとき（ロマサガの各系統のエレメンタルなど）は、補足の冒頭（「火術」など）で区別する
const twin = PAGE_MAGICS.some((x) => x !== m && x.game === m.game && x.name === m.name);
const tag = twin ? (m.note?.split('。')[0] ?? '').slice(0, 8) || m.id : '';
const label = tag ? `${m.name}・${tag}` : m.name;

// 他作品：同じ属性×用途（細分類がある用途は同じ細分類）の系統。この魔法と同じ段階（足りなければ最上位）を並べる
const rows = compareRows(m.el, m.fx).filter((r) => !F.kinds || r.kind === (m.kind ?? null));
const allNames = firstNames(rows);
const otherRows = rows.filter((r) => r.g.id !== groupOf(m.game));
const others = otherRows.map(({ g, list }) => {
  const ei = Math.max(0, Math.min(idx, list.length - 1)), eq = list[ei];
  return { g, list, eq, tier: `${ei + 1}段目${ei < idx ? '・最上位' : ''}` };
});
const OTHERS_MAX = 12;
const what = kn ? `${F.name}（${kn}）の魔法` : cmpTitle;
const nGames = new Set(rows.map((r) => r.g.id)).size;

// 同じシリーズで同じ名前の魔法（登場作品の表）
const apps = appearancesOf(m).map((x) => ({ x, g: gameById[x.game] }));
// 作品の体系：同じ用途の系統を並べ、この魔法の系統に印を付ける
const groups = buildGroups(m.game, [m.fx], { curId: m.id });
// 魔法の呼び方：この作品の呼び方を先頭に、作品数の多い順
const names = [...NAMING.map((t, i) => ({ ...t, i, games: t.items.filter((x) => x.href) }))]
  .filter((t) => t.games.length)
  .sort((a, b) => Number(b.term === G.sys) - Number(a.term === G.sys) || b.games.length - a.games.length)
  .slice(0, 6);
// 出典は URL の重複を除く
const src = (m.src ?? []).filter((s, i, a) => a.findIndex((x) => x.url === s.url) === i);
// 読みもの（stories.json）。下書き（draft）は公開しない
type Story = { lead: string[]; chapters: { phase: string; title: string; body: string }[]; ask: string; memories: string[]; draft?: boolean };
const story = (storiesData as Record<string, Story>)[m.id];
const ST = story && !story.draft ? story : null;
const KANJI = ['一', '二', '三', '四', '五', '六'];

// 説明文・共有文の例は、作品が重ならないように選ぶ（「FFVでは…、FFVでは…」を避ける）
const otherFirst = firstNames(otherRows);
const otherEx = otherFirst.filter((o, i, a) => a.findIndex((x) => x.games[0] === o.games[0]) === i).map((o) => `${o.games[0].short}では${o.name}`);
const otherSample = otherEx.slice(0, 2).join('、');
const url = new URL(magicUrl(m), Astro.site ?? Astro.url).href;
const shareBase = `${m.name}（${G.short}）${otherSample ? `は、${otherSample}。` : ''}\n${url}`;
const lineHref = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
// 他作品の呼び名がない魔法は、データから組んだ1文（＋効果の要約）で説明する
const description = others.length
  ? `${G.name}の${label}は、他のRPGでは何と呼ばれる？ ${otherEx.slice(0, 3).join('、')}など。`
  : `${G.name}の${label}。${lead.head}${lead.chain ? `${lead.chain.root}系統の${lead.chain.tier}段目（全${lead.chain.n}段）。` : ''}${m.desc ?? ''}`.slice(0, 120);
// 辞典の1項目として、作品の魔法体系（DefinedTermSet）に属する語（DefinedTerm）と示す
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'DefinedTerm', name: m.name, url,
  ...(m.kana ? { alternateName: m.kana } : {}),
  description: m.desc ?? lead.head,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: `${G.name}の魔法体系`, url: new URL(systemUrl(m.game), Astro.site ?? Astro.url).href },
}];
const gauge = tone(E).ink;
const segs = [...Array(Math.max(4, ch.length)).keys()];
---
<Base
  title={`${label}（${G.name}）の他作品での呼び名と系統｜RPG魔法辞典`}
  description={description} jsonld={jsonld}
  active="compare" path={magicUrl(m)}
  crumbs={[{ name: 'トップ', path: '/' }, { name: cmpTitle, path: cmpHref }, { name: m.name, path: magicUrl(m) }]}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><a href={cmpHref}>{cmpTitle}</a><span>›</span><span aria-current="page">{m.name}</span></nav>

    <header class="m-head">
      <a class="m-game" href={systemUrl(m.game)}>{G.name}<span> の{sysName}</span></a>
      <h1 class:list={['m-name', { 'is-long': [...m.name].length > 6 }]}>{m.name}</h1>
      {m.kana && <p class="m-kana">{m.kana}</p>}
      {ST && <p class="m-lead">{ST.lead.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>}
      {ST && (
        <ol class="m-toc" aria-label={`${m.name}との冒険`}>
          {ST.chapters.map((c, i) => <li><a href={`#ch${i + 1}`}><span class="k">{KANJI[i]}</span><span class="t">{c.title}</span><span class="ph">{c.phase}</span></a></li>)}
        </ol>
      )}
      <div class="badges">
        {E && <a class="badge" href={m.fx === 'atk' ? `/element/${E.id}` : cmpHref}><span class="mark" style={markStyle(E, 22)} aria-hidden="true">{E.name}</span>{E.id === 'none' ? '無属性' : `${E.name}属性`}</a>}
        {/* 攻撃は用途だけの比較ページがない（属性ごと）ので、属性のバッジだけをリンクにする */}
        {m.fx === 'atk'
          ? <span class="badge"><span class="mark" style={markStyle(null, 22)} aria-hidden="true">{F.kanji}</span>{F.name}{kn && `（${kn}）`}</span>
          : <a class="badge" href={compareUrl(null, m.fx)}><span class="mark" style={markStyle(null, 22)} aria-hidden="true">{F.kanji}</span>{F.name}{kn && `（${kn}）`}</a>}
        {m.scope && <span class="badge"><span class="mark" style={markStyle(null, 22)} aria-hidden="true">的</span>{m.scope}</span>}
        {ch.length > 1 && <span class="badge"><span class="mark" style={markStyle(null, 22)} aria-hidden="true">段</span>系統 {idx + 1} / {ch.length}</span>}
      </div>
      <div class="m-effect">
        <span class="lbl">効果</span>
        <p>{lead.head}{lead.chain && <>{lead.chain.root}系統の{lead.chain.tier}段目（全{lead.chain.n}段）。</>}{m.desc}</p>
        {m.note && <p class="m-note">{m.note}</p>}
      </div>
    </header>

    <div class="stats">
      <div class="card stat">
        <span class="lbl">威力段階</span>
        <span class="gauge gauge-lg" style={`--g:${gauge}`} aria-hidden="true">{segs.map((j) => <i class:list={{ on: j <= idx && j < ch.length }}></i>)}</span>
        <span class="stat-v">{ch.length > 1 ? `${idx + 1}段目` : '1段のみ'}</span><span class="stat-s">{ch.length > 1 ? `系統全${ch.length}段中` : 'この系統はこの1つだけ'}</span>
      </div>
      <div class="card stat"><span class="lbl">対象</span><span class="stat-v">{m.scope ?? '—'}</span><span class="stat-s">{m.scope ? '作品・版により異なることがある' : '資料で確認できず'}</span></div>
      <div class="card stat"><span class="lbl">作品内の分類</span><span class="stat-v">{subOf(m)}</span><span class="stat-s">{G.name}</span></div>
      <div class="card stat"><span class="lbl">作品内の属性名</span><span class="stat-v">{eln ?? (E ? E.name : '—')}</span><span class="stat-s">{eln ? `${E!.name}属性をこう呼ぶ` : E ? '固有の呼び名なし' : '属性なし'}</span></div>
      {m.cost && <div class="card stat"><span class="lbl">消費</span><span class="stat-v">{m.cost}</span></div>}
      {m.users && m.users.length > 0 && <div class:list={['card stat', { 'is-wide': m.users.join('、').length > 16 }]}><span class="lbl">主な使用者</span><span class="stat-v is-sm">{m.users.join('、')}</span></div>}
    </div>

    {ch.length > 1 && (
      <section class="sec">
        <Chapter title={`同系統の${sysName}`} note="対象範囲は作品や版によって変わることがあります" />
        <ol class="lineage">
          {ch.map((c, i) => (
            <>
              {i > 0 && <li class="lineage-sep" aria-hidden="true">→</li>}
              <li><a href={magicUrl(c)} aria-current={c.id === m.id ? 'page' : undefined}>
                <span class="tier">{i + 1}段目</span><span class="min">{c.name}</span>{c.scope && <span class="scope">{c.scope}</span>}
              </a></li>
            </>
          ))}
        </ol>
      </section>
    )}

    <section class="sec">
      <Chapter title="他作品では？">
        <a class="more" href={cmpHref}>{cmpTitle}をすべて比較 →</a>
      </Chapter>
      {others.length === 0 ? (
        <p class="sec-intro">この組み合わせは、ほかの作品にはまだ収録されていません。</p>
      ) : (
        <>
          <p class="sec-intro">{what}は、{nGames}作品で{allNames.length}通りの名前があります。各作品の系統から、この{sysName}と同じ段階のものを並べました。</p>
          <div class="card others tbl-wrap">
            <table class="tbl o-tbl">
              <thead><tr><th scope="col">作品</th><th scope="col">同じ段階（{ch.length > 1 ? `${idx + 1}段目` : '1段目'}）</th><th scope="col">系統</th><th scope="col">分類</th></tr></thead>
              <tbody>
                {others.map((o, i) => (
                  <tr data-more-item={i >= OTHERS_MAX ? 'others' : undefined} hidden={i >= OTHERS_MAX}>
                    <th scope="row"><a class="mx-game" href={systemUrl(o.g.id)}>{o.g.name}</a></th>
                    <td><a class="o-eq" href={magicUrl(o.eq)}><span class="min">{o.eq.name}</span><small>{o.tier}</small></a></td>
                    <td><div class="o-chain">{o.list.map((x, j) => <>{j > 0 && <span aria-hidden="true">›</span>}<a class:list={{ 'is-eq': x.id === o.eq.id }} href={magicUrl(x)}>{x.name}</a></>)}</div></td>
                    <td class="o-sys">{subOf(o.eq)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {others.length > OTHERS_MAX && <button class="btn btn-line btn-more" type="button" data-more="others" data-less={`${OTHERS_MAX}系統に戻す`} aria-expanded="false">残り{others.length - OTHERS_MAX}系統も表示（全{others.length}系統）</button>}
        </>
      )}
    </section>

    {apps.length > 1 && (
      <section class="sec">
        <Chapter title={`${m.name}が出てくる作品`} note={`${apps.length}作品`} />
        <div class="card others tbl-wrap">
          <table class="tbl" aria-label={`${m.name}が出てくる作品`}>
            <thead><tr><th scope="col">作品</th><th scope="col">消費</th><th scope="col">主な使用者</th></tr></thead>
            <tbody>
              {apps.map(({ x, g }) => (
                <tr>
                  <th scope="row"><a class="mx-game" href={systemUrl(g.id)}>{g.short}</a></th>
                  <td class="num">{x.cost ?? '—'}</td>
                  <td>{x.users?.join('、') ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {ST && (
      <section class="sec story" aria-labelledby="story-h">
        <Chapter id="story-h" title={`${m.name}との冒険（全${ST.chapters.length}章）`} />
        {ST.chapters.map((c, i) => (
          <article class="ch" id={`ch${i + 1}`}>
            <span class="ch-no">第{i + 1}章　{c.phase}</span>
            <h3 class="ch-t">{c.title}</h3>
            <p class="ch-b">{c.body}</p>
          </article>
        ))}
      </section>
    )}

    {G.shop?.[0] && (
      <div class="sec">
        <BuyBox game={G} />
      </div>
    )}

    <section class="sec">
      <Chapter title="この作品の魔法体系">
        <a class="more" href={systemUrl(m.game)}>{G.name}の魔法体系を見る →</a>
      </Chapter>
      <div class="two">
        <div class="card sys-card">
          {S && <p class="prose">{S.overview}</p>}
          <div class="sys-mini">
            {groups.map((gp) => (
              <div class:list={{ 'is-cur': gp.lines.some((ln) => ln.items.some((it) => it.cur)) }}>
                <div class="grp-head"><span class="mark" style={markStyle(gp.el, 24)} aria-hidden="true">{gp.mark}</span>{gp.label}</div>
                <Chain lines={gp.lines} />
              </div>
            ))}
          </div>
        </div>
        <div class="card names">
          <span class="lbl">魔法の呼び方</span>
          <p>作品によって「魔法」の呼び方も違います。</p>
          {names.map((t) => (
            <a class:list={['names-row', { 'is-cur': t.term === G.sys }]} href={`/names#t${t.i}`}>
              <span>{t.games.slice(0, 2).map((x) => x.short).join('・')}{t.games.length > 2 && ` ほか${t.games.length - 2}作品`}</span><span class="min">{t.term}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {src.length > 0 && (
      <section class="sec" aria-labelledby="src-h">
        <Chapter id="src-h" title="出典" note={`名称・効果の確認に使った資料（${src.length}件）`} />
        <ul class="src-list">{src.map((x, i) => <li data-more-item={i >= 4 ? 'src' : undefined} hidden={i >= 4}><a href={x.url} rel="nofollow noopener" target="_blank">{x.title}</a></li>)}</ul>
        {src.length > 4 && <button class="link-btn" type="button" style="margin-top:8px;font-size:14px" data-more="src" data-less="4件に戻す" aria-expanded="false">すべて表示（{src.length}件）</button>}
      </section>
    )}
  </main>

  <section class="mem" aria-labelledby="mem-h" data-share={shareBase} data-name={m.name}>
    <div class="mem-in">
      <div>
        <span class="mem-lbl">みんなの思い出</span>
        <h2 class="mem-h" id="mem-h">{ST?.ask ?? `${m.name}で、何を思い出す？`}</h2>
        <p class="mem-p">書かなくてもかまいません。ひとこと添えて共有したいときだけ使ってください。投稿前に必ず内容を確認できます。</p>
        <div class="mem-share actions">
          <a href={lineHref} target="_blank" rel="noopener" aria-label="LINEで送る">LINE</a>
          <button type="button" data-act="copy" aria-label="リンクをコピー">リンク</button>
        </div>
      </div>
      <div>
        <div data-step="edit">
          <label for="memo">思い出（任意・60字まで）</label>
          <textarea id="memo" maxlength="60" rows="2" placeholder="例：冬にこたつで、兄のプレイを横で見ていた頃"></textarea>
          <div class="actions"><button class="mem-btn" type="button" data-act="confirm">共有する内容を確認</button></div>
        </div>
        <div data-step="confirm" hidden>
          <span class="mem-lbl">この内容で投稿します</span>
          <p class="mem-preview" data-preview></p>
          <div class="actions mem-share">
            <a class="mem-btn" href="#" target="_blank" rel="noopener" data-act="post">Xで投稿する</a>
            <button type="button" data-act="back">書き直す</button>
          </div>
        </div>
        {ST && ST.memories.length > 0 && <div class="mem-list">{ST.memories.map((q) => <p>「{q}」</p>)}</div>}
      </div>
    </div>
  </section>
</Base>

<script>
  // 思い出の共有：確認画面を挟んで X の投稿画面を開く（自動では投稿しない）
  const box = document.querySelector<HTMLElement>('[data-share]');
  if (box) {
    const memo = box.querySelector('textarea')!;
    const steps = box.querySelectorAll<HTMLElement>('[data-step]');
    const show = (s: string) => steps.forEach((x) => (x.hidden = x.dataset.step !== s));
    const toast = (msg: string) => {
      const t = Object.assign(document.createElement('div'), { className: 'toast', textContent: msg });
      t.setAttribute('role', 'status');
      document.body.append(t);
      setTimeout(() => t.remove(), 2200);
    };
    const text = () => {
      const v = memo.value.trim();
      return (v ? `「${box.dataset.name}」で思い出すこと：${v}\n` : '') + box.dataset.share;
    };
    box.querySelector('[data-act="confirm"]')!.addEventListener('click', () => {
      box.querySelector('[data-preview]')!.textContent = text();
      box.querySelector<HTMLAnchorElement>('[data-act="post"]')!.href = 'https://x.com/intent/post?text=' + encodeURIComponent(text());
      show('confirm');
    });
    box.querySelector('[data-act="back"]')!.addEventListener('click', () => show('edit'));
    box.querySelector('[data-act="copy"]')!.addEventListener('click', () =>
      navigator.clipboard.writeText(location.href).then(() => toast('リンクをコピーしました'), () => toast('コピーできませんでした')),
    );
  }
</script>
