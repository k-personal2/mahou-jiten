---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import BuyBox from '../components/BuyBox.astro';
import { STATS, statsText, gameById, magicUrl, compareUrl, jstDateStr, BLUEPRINT_TIER_URL } from '../lib/dict';
import { today as tm, todayLead, todayChain, eg, egCompare, reading, findEls, findFx } from '../lib/home';

const examples = ['ヒャド', 'ブリザド', 'サガ', 'ひょう', 'テイルズ'];
const LABEL: Record<string, string> = { dq: 'ドラゴンクエスト', ff: 'FINAL FANTASY', smt: '真・女神転生', mother: 'MOTHER' };

// 今日の魔法（ビルド日で決まる）
const tG = gameById[tm.game];
const dateStr = jstDateStr();
const KANJI = ['一', '二', '三', '四', '五', '六', '七', '八'];
const sysName = tG.sys === 'なし' ? '魔法' : tG.sys;
---
<Base title="RPG魔法辞典｜ドラクエ・FF・メガテンの魔法を比較" active="home" path="/" hideSearch alternates={{ ja: '/', en: '/en' }}
  description={`メラ・ファイア・アギ・PKファイアー…同じ役割の魔法が、RPGごとにどう呼ばれているかを比較する辞典。${STATS.games}作品・${STATS.magics.toLocaleString()}種の魔法と、作品ごとの魔法体系を収録。`}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'RPG魔法辞典', url: Astro.site?.href, inLanguage: 'ja', description: 'RPGの魔法の呼び名を作品横断で比較する辞典' }]}>
  <main class="home2">
    <section class="h-top wrap">
      <div class="h-title">
        <span class="k-lbl">{statsText}</span>
        <h1>RPG魔法辞典</h1>
        <p>あのゲームの「あの魔法」、別のRPGでは何て呼ぶ？</p>
      </div>
      <div class="h-search">
        <Search size="lg" />
        <div class="h-ex"><span class="note">検索の例</span>{examples.map((x) => <button class="chip-ex" type="button" data-fill={x}>{x}</button>)}</div>
      </div>
      <div class="h-eg">
        <span class="k-lbl">たとえば</span>
        <p class="eg">
          {eg.map(({ gid, m }, i) => (
            <>
              <span class="eg-j">{i === 0 ? `${LABEL[gid]}の` : `${LABEL[gid]}なら`}</span><a class="eg-n min" href={magicUrl(m)}>「{m.name}」</a><span class="eg-j">{i === 0 ? 'は、' : i === eg.length - 1 ? '。' : '、'}</span>
            </>
          ))}
        </p>
        <div class="eg-links">
          <a class="act" href={egCompare.href}>氷の攻撃魔法を、{egCompare.nGames}作品で比べる →</a>
          <span class="spacer"></span>
          <span class="note">ほかの言い換え</span>
          <a href={compareUrl('fire', 'atk')}>炎の攻撃</a><a href={compareUrl('thunder', 'atk')}>雷の攻撃</a><a href={compareUrl(null, 'heal')}>回復</a>
        </div>
      </div>
    </section>

    <section class="h-today" aria-labelledby="today-h">
      <div class="wrap h-today-in">
        <div class="t-main">
          <div class="t-head"><h2 class="k-lbl" id="today-h">今日の魔法</h2><span class="note">{dateStr}</span></div>
          <span class="t-game">{tG.name} ／ {tG.sys}</span>
          <a class="t-name min" href={magicUrl(tm)}>{tm.name}</a>
          <p class="t-lead">{todayLead.head}{todayLead.chain && <>{todayLead.chain.root}系統の{todayLead.chain.tier}段目（全{todayLead.chain.n}段）。</>}</p>
          {tG.shop?.[0] && <div class="t-buy"><BuyBox game={tG} compact /></div>}
          {todayChain.length > 1 && (
            <>
              <span class="k-lbl t-toc-h">{todayChain[0].m.name}の系統（全{todayChain.length}段）</span>
              <ol class="t-toc">
                {todayChain.map((c, i) => <li><a href={c.href} aria-current={c.cur ? 'page' : undefined}><span class="k">{KANJI[i] ?? i + 1}</span><span class="t">{c.m.name}</span><span class="ph">{c.m.scope ?? `${i + 1}段目`}</span></a></li>)}
              </ol>
            </>
          )}
          <div class="t-act"><a class="btn-ink" href={magicUrl(tm)}>この{sysName}を見る →</a><a class="act" href="#" data-random>ランダムに引く →</a></div>
        </div>
        <aside class="t-mem" aria-label="みんなの思い出">
          <span class="k-lbl">みんなの思い出</span>
          <p class="t-q">「{tm.name}」で、何を思い出す？</p>
          <p class="t-q-sub">「これ、何だっけ？」となるRPGの魔法を、毎日ひとつ。ひとこと添えて、遊んだ人と共有できます。</p>
          <span class="note">{tm.name} ／ {tG.short}</span>
          <span class="spacer"></span>
          <a class="act" href={`${magicUrl(tm)}#mem-h`}>ひとこと残す →</a>
        </aside>
      </div>
    </section>

    <section class="h-essay" aria-labelledby="essay-h">
      <div class="wrap">
        <div class="e-head"><h2 class="min" id="essay-h">魔法のある世界を考える</h2><span class="note">名前の付け方から、作品ごとの世界の作りを読む</span></div>
        <div class="e-grid">
          <a class="e-lead" href={BLUEPRINT_TIER_URL}><span class="note">魔法世界の設計図 ／ {reading.tierGames}作品</span><p class="min">魔法の段階は、どう名付ける？</p><p class="e-lede">メラ → メラミ → メラゾーマ。ファイア → ファイラ → ファイガ。強くなったときの名前の付け方を、{reading.tierTypes}つの型に分けました。</p><span class="act">読む →</span></a>
          <a href="/names"><span class="note">呼び方 ／ {reading.namingTerms}通り</span><p class="min">呪文・術・PSI。「魔法」を何と呼ぶ？</p><span class="act">読む →</span></a>
          <a href="/about"><span class="note">この辞典について</span><p class="min">あの頃、夢中だった。名前を眺めるための辞典</p><span class="act">読む →</span></a>
        </div>
      </div>
    </section>

    <nav class="h-find wrap" aria-label="探す">
      <b>探す</b>
      <span class="note">属性</span>{findEls.map((e) => <a href={`/element/${e.id}`}>{e.name}</a>)}
      <span class="note">用途</span>{findFx.map((f) => <a href={compareUrl(null, f.id)}>{f.name}</a>)}
      <span class="note">ほか</span><a href="/game">作品から（{STATS.games}作品）</a><a href="/names">魔法の呼び方から</a>
    </nav>
  </main>
</Base>
