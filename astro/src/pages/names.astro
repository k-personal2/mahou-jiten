---
import Base from '../layouts/Base.astro';
import Chapter from '../components/Chapter.astro';
import { NAMING } from '../lib/dict';

const nGames = NAMING.reduce((a, t) => a + t.items.filter((i) => i.href).length, 0);
---
<Base title="RPGで魔法を何と呼ぶ？ 呼び方の一覧｜RPG魔法辞典" path="/names" active="names"
  description={`呪文・魔法・術・PSI・策略・変身技…。RPGでは作品ごとに「魔法」の呼び方が違います。${NAMING.length}通りの呼び方と、それぞれの仕組み、使っている作品の一覧。`}
  crumbs={[{ name: 'トップ', path: '/' }, { name: '魔法を何と呼ぶ？', path: '/names' }]}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><span aria-current="page">魔法を何と呼ぶ？</span></nav>
    <h1 class="p-title">魔法を何と呼ぶ？</h1>
    <p class="p-lead">ドラゴンクエストは「呪文」、MOTHERは「PSI」、サガは「術」。RPGの「魔法」は、作品によって呼び方も仕組みも違います。収録{nGames}作品の呼び方を、{NAMING.length}通りに分けて並べました。</p>
    <nav class="toc" aria-label="呼び方の目次">
      {NAMING.map((t, i) => <a class="chip" href={`#t${i}`}>{t.term}<span class="note">{t.items.length}</span></a>)}
    </nav>

    {NAMING.map((t, i) => (
      <section class="sec" id={`t${i}`}>
        <Chapter title={t.term} note={`${t.items.length}作品`} />
        <div class="card box">
          {t.desc ? <p class="prose">{t.desc}</p> : <p class="note">この呼び方の作品は準備中です。</p>}
          <div class="term-games">
            {t.items.map((it) => (it.href ? <a class="chip" href={it.href}>{it.name}</a> : <span class="chip" style="color:var(--mut)">{it.name}（準備中）</span>))}
          </div>
        </div>
      </section>
    ))}
  </main>
</Base>
