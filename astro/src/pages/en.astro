---
/**
 * 英語版トップ（/en）。英語にしているのはこのページだけで、リンク先は日本語のページ。
 * 並べる魔法と件数は日本語版トップと同じ（src/lib/home.ts）。魔法名は日本語版の表記に、ローマ字の読みを添える
 */
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import BuyBox from '../components/BuyBox.astro';
import { STATS, gameById, elById, magicUrl, compareUrl, jstDateStr, BLUEPRINT_TIER_URL } from '../lib/dict';
import { today as tm, todayChain, eg, egCompare, reading, findEls, findFx } from '../lib/home';
import { GAME_EN, EL_EN, FX_EN, sysEn, statsTextEn, readingOf } from '../lib/en';

const gEn = (id: string) => GAME_EN[id];
const elLabel = (id: string) => (id === 'none' ? 'non-elemental' : `${EL_EN[id].toLowerCase()}-element`);
const LABEL: Record<string, string> = { dq: 'Dragon Quest', ff: 'Final Fantasy', smt: 'Shin Megami Tensei', mother: 'MOTHER' };

// Spell of the day
const tG = gameById[tm.game], tE = tm.el ? elById[tm.el] : null;
const tRo = readingOf(tm);
const tWhat = [tE ? elLabel(tE.id) : null, FX_EN[tm.fx].toLowerCase(), 'spell'].filter(Boolean).join(' ');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const tIdx = todayChain.findIndex((c) => c.cur);
const tLead = `A${/^[aeiou]/.test(tWhat) ? 'n' : ''} ${tWhat}.${todayChain.length > 1 ? ` Tier ${tIdx + 1} of ${todayChain.length} in the ${readingOf(todayChain[0].m) ?? todayChain[0].m.name} line.` : ''}`;
const dateStr = jstDateStr();

const title = 'RPG Spell Name Thesaurus | What is that spell called in other Japanese RPGs?';
const description = `Mera, Fire, Agi, PK Fire… The same spell goes by a different name in every Japanese RPG. Compare ${STATS.magics.toLocaleString('en-US')} spells from ${STATS.games} games, as named in the original Japanese releases.`;
---
<Base {title} {description} lang="en" active="home" path="/en" hideSearch alternates={{ ja: '/', en: '/en' }}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'RPG Spell Name Thesaurus', alternateName: 'RPG魔法辞典', url: new URL('/en', Astro.site).href, inLanguage: 'en', description: 'A dictionary comparing what Japanese RPGs call the same spell' }]}>
  <main class="home2">
    <section class="h-top wrap">
      <div class="h-title">
        <span class="k-lbl">{statsTextEn}</span>
        <h1>RPG Spell Name Thesaurus</h1>
        <p>You know the spell from one game. What is it called in the next RPG?</p>
      </div>
      <div class="h-search">
        <Search size="lg" en />
        <div class="h-ex"><span class="note">Try</span>{['ヒャド', 'ブリザド', 'ホイミ'].map((x) => <button class="chip-ex" type="button" data-fill={x} lang="ja">{x}</button>)}</div>
      </div>
      <div class="h-eg">
        <span class="k-lbl">For example</span>
        <p class="eg">
          {eg.map(({ gid, m }, i) => (
            <>
              <span class="eg-j">{i === 0 ? `In ${LABEL[gid]}, ice is` : i === eg.length - 1 ? `and in ${LABEL[gid]}` : `in ${LABEL[gid]}`}</span><a class="eg-n min" href={magicUrl(m)} hreflang="ja" lang="ja">{m.name}</a>{readingOf(m) && <span class="eg-ro">({readingOf(m)})</span>}<span class="eg-j">{i === eg.length - 1 ? '.' : ','}</span>
            </>
          ))}
        </p>
        <div class="eg-links">
          <a class="act" href={egCompare.href} hreflang="ja">Compare ice attack spells across {egCompare.nGames} games →</a>
          <span class="spacer"></span>
          <span class="note">More</span>
          <a href={compareUrl('fire', 'atk')} hreflang="ja">Fire attacks</a><a href={compareUrl('thunder', 'atk')} hreflang="ja">Thunder attacks</a><a href={compareUrl(null, 'heal')} hreflang="ja">Healing</a>
        </div>
        <p class="h-note">Only this page is in English. Spell names appear as written in the original Japanese releases, with a romanized reading; the pages they link to are in Japanese. English releases often rename spells — Dragon Quest’s <span lang="ja">メラ</span> (Mera) became Frizz, and <span lang="ja">ホイミ</span> (Hoimi) became Heal.</p>
      </div>
    </section>

    <section class="h-today" aria-labelledby="today-h">
      <div class="wrap h-today-in">
        <div class="t-main">
          <div class="t-head"><h2 class="k-lbl" id="today-h">Spell of the day</h2><span class="note">{dateStr}</span></div>
          <span class="t-game">{gEn(tm.game).name} / {cap(sysEn(tG.sys))}</span>
          <a class="t-name min" href={magicUrl(tm)} hreflang="ja" lang="ja">{tm.name}</a>
          {tRo && <span class="t-ro">{tRo}</span>}
          <p class="t-lead">{tLead}</p>
          {tG.shop?.[0] && <div class="t-buy"><BuyBox game={tG} compact en /></div>}
          {todayChain.length > 1 && (
            <>
              <span class="k-lbl t-toc-h">The whole line ({todayChain.length} tiers)</span>
              <ol class="t-toc">
                {todayChain.map((c, i) => <li><a href={c.href} hreflang="ja" aria-current={c.cur ? 'page' : undefined}><span class="k">{i + 1}</span><span class="t" lang="ja">{c.m.name}</span><span class="ph">{readingOf(c.m)}</span></a></li>)}
              </ol>
            </>
          )}
          <div class="t-act"><a class="btn-ink" href={magicUrl(tm)} hreflang="ja">See this spell →</a><a class="act" href="#" data-random>Show a random spell →</a></div>
        </div>
        <aside class="t-mem" aria-label="Memories">
          <span class="k-lbl">Memories</span>
          <p class="t-q">What does <span lang="ja">{tm.name}</span> bring back?</p>
          <p class="t-q-sub">One half-remembered RPG spell, every day. Add a line and share it with people who played it too.</p>
          <span class="note">{FX_EN[tm.fx]} / {gEn(tm.game).short}</span>
          <span class="spacer"></span>
          <a class="act" href={`${magicUrl(tm)}#mem-h`} hreflang="ja">Share a memory (Japanese page) →</a>
        </aside>
      </div>
    </section>

    <section class="h-essay" aria-labelledby="essay-h">
      <div class="wrap">
        <div class="e-head"><h2 class="min" id="essay-h">Thinking about worlds with magic</h2><span class="note">Reading a world from the way it names its spells (in Japanese)</span></div>
        <div class="e-grid">
          <a class="e-lead" href={BLUEPRINT_TIER_URL} hreflang="ja"><span class="note">Blueprint / {reading.tierGames} games</span><p class="min">How do games name the stronger version of a spell?</p><p class="e-lede">Mera → Merami → Merazoma. Fire → Fira → Firaga. PK Fire α → Ω. The naming rules of {reading.tierGames} games, sorted into {reading.tierTypes} types.</p><span class="act">Read →</span></a>
          <a href="/names" hreflang="ja"><span class="note">{reading.namingTerms} words for magic</span><p class="min">Spells, arts, PSI — what do games call magic?</p><span class="act">Read →</span></a>
          <a href="/about" hreflang="ja"><span class="note">About</span><p class="min">A dictionary for looking at names, not a strategy guide</p><span class="act">Read →</span></a>
        </div>
      </div>
    </section>

    <nav class="h-find wrap" aria-label="Find spells">
      <b>Find</b>
      <span class="note">Element</span>{findEls.map((e) => <a href={`/element/${e.id}`} hreflang="ja">{e.id === 'none' ? 'Non-elemental' : EL_EN[e.id]}</a>)}
      <span class="note">Effect</span>{findFx.map((f) => <a href={compareUrl(null, f.id)} hreflang="ja">{FX_EN[f.id]}</a>)}
      <span class="note">More</span><a href="/game" hreflang="ja">All {STATS.games} games</a><a href="/names" hreflang="ja">What they call magic</a>
    </nav>
  </main>
</Base>
