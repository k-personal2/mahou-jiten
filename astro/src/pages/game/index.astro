---
import Base from '../../layouts/Base.astro';
import Chain from '../../components/Chain.astro';
import { CATALOG, GAMES, REP_GAMES, SYSTEMS, seriesGames, MAGICS, gameById, buildGroups, markStyle, systemUrl } from '../../lib/dict';

// 「魔法を何と呼ぶ？」：呼び方ごとに作品をまとめる（シリーズは代表作品だけ。準備中の作品は catalog から）
type NameItem = { name: string; href?: string };
const terms = new Map<string, NameItem[]>();
const add = (sys: string, it: NameItem) => { if (sys && sys !== '—') terms.set(sys, [...(terms.get(sys) ?? []), it]); };
REP_GAMES.filter((g) => SYSTEMS[g.id]).forEach((g) => add(g.sys, { name: g.short, href: systemUrl(g.id) }));
CATALOG.flatMap((c) => c.items).filter((it) => !it.game).forEach((it) => add(it.sys, { name: it.name }));
const termList = [...terms];
---
<Base title="作品から探す｜RPG魔法の言い換え辞典" active="games" path="/game"
  description={`ドラゴンクエスト、FINAL FANTASY、真・女神転生、MOTHER、サガシリーズなど、収録${GAMES.length}作品の一覧。作品ごとに「魔法」を何と呼ぶか（呪文・術・PSIなど）と、収録している魔法の系統を見られます。`}
  crumbs={[{ name: 'トップ', path: '/' }, { name: '作品から探す', path: '/game' }]}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><span aria-current="page">作品から探す</span></nav>
    <h1 class="sys-title" style="margin-top:18px">作品から探す</h1>
    <p class="cmp-lead" style="font-size:16px;margin-top:10px">収録作品と、各作品での魔法の呼び方。行を開くと収録魔法を一覧できます。</p>

    <section class="sec" aria-labelledby="terms-h">
      <div class="sec-head"><h2 class="h2" id="terms-h">魔法を何と呼ぶ？</h2><span class="note">{termList.length}通りの呼び方</span></div>
      <p class="prose" style="margin-top:8px">同じ「魔法」でも、作品によって呼び方はさまざま。呼び方から、その作品の魔法体系を読めます。</p>
      <ul class="terms">
        {termList.map(([sys, items]) => (
          <li class="card term">
            <b class="term-name">{sys}</b>
            <span class="term-games">
              {items.map((it) => it.href ? <a href={it.href}>{it.name}</a> : <span class="is-off" title="準備中">{it.name}</span>)}
            </span>
          </li>
        ))}
      </ul>
    </section>

    {CATALOG.map((cat) => (
      <section class="g-cat">
        <div class="sec-head"><h2 class="h2">{cat.name}</h2><span class="note">{cat.items.length}作品</span></div>
        <div class="card glist">
          <div class="g-row g-head"><span>作品</span><span>魔法の呼び方</span><span style="text-align:right">収録</span><span>URL</span><span></span></div>
          {cat.items.map((it) => {
            const g = it.game ? gameById[it.game] : null;
            if (!g) return (
              <div class="g-item is-off"><div class="g-row">
                <span><span class="g-name">{it.name}</span><span class="g-sp">{it.sys} · 準備中</span></span>
                <span class="g-sys">{it.sys}</span><span class="g-num">準備中</span><span class="url">/game/{it.slug}</span><span></span>
              </div></div>
            );
            const n = MAGICS.filter((m) => m.game === g.id).length;
            const sys = g.sys;
            return (
              <details class="g-item">
                <summary class="g-row">
                  <span><span class="g-name">{it.name}</span><span class="g-sp">{sys} · {n}件</span></span>
                  <span class="g-sys">{sys}</span><span class="g-num">{n}件</span><span class="url">{systemUrl(g.id)}</span>
                </summary>
                <div class="g-body">
                  <a class="more" style="font-weight:700" href={systemUrl(g.id)}>{it.name}の魔法体系を読む →</a>
                  {seriesGames(g.id).length > 1 && (
                    <p class="g-series"><span class="lbl">シリーズの各作品</span>{seriesGames(g.id).filter((x) => x.group).map((x) => <a href={systemUrl(x.id)}>{x.short}</a>)}</p>
                  )}
                  {/* 一覧では攻撃・回復の見本だけ（全系統は魔法体系ページ）。ページを軽くするため */}
                  {buildGroups(g.id, ['atk', 'heal']).slice(0, 6).map((gp) => (
                    <div class="g-group">
                      <span class="g-group-lbl"><span class="mark" style={markStyle(gp.el, 20)}>{gp.mark}</span>{gp.label}</span>
                      <Chain lines={gp.lines} />
                    </div>
                  ))}
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </main>
</Base>
