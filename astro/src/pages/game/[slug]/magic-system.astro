---
import Base from '../../../layouts/Base.astro';
import Chapter from '../../../components/Chapter.astro';
import Chain from '../../../components/Chain.astro';
import { GAMES, REP_GAMES, seriesGames, groupOf, EL, MAGICS, SYSTEMS, buildGroups, elnOf, elInk, systemUrl, chainOfMagic, type Game } from '../../../lib/dict';

export function getStaticPaths() {
  return GAMES.filter((g) => SYSTEMS[g.id]).map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Game };
const S = SYSTEMS[g.id];
const count = MAGICS.filter((m) => m.game === g.id).length;
const SECS: [string, string[]][] = [
  ['攻撃魔法', ['atk']], ['回復魔法', ['heal']], ['補助魔法', ['atkup', 'defup', 'spdup']], ['弱体魔法', ['atkdown', 'defdown', 'spddown']],
  ['状態異常・即死', ['ailment', 'death']], ['治療・蘇生', ['cure', 'revive']], ['防御・移動・その他', ['barrier', 'field', 'misc']],
];
const sections = SECS.map(([title, fl]) => {
  const groups = buildGroups(g.id, fl);
  const n = groups.reduce((a, gp) => a + gp.lines.reduce((b, l) => b + l.items.length, 0), 0);
  return { title, groups, n };
}).filter((s) => s.groups.length);
const elements = EL.filter((e) => MAGICS.some((m) => m.game === g.id && m.el === e.id)).map((e) => ({ e, local: elnOf(g.id, e.id) }));
const siblings = seriesGames(g.id).filter((x) => SYSTEMS[x.id]);
const otherGames = REP_GAMES.filter((x) => x.id !== groupOf(g.id) && SYSTEMS[x.id] && MAGICS.some((m) => m.game === x.id)).map((x) => {
  const c = MAGICS.find((m) => m.game === x.id && m.fx === 'atk' && m.el === 'fire') ?? MAGICS.find((m) => m.game === x.id && m.fx === 'atk') ?? MAGICS.find((m) => m.game === x.id);
  return { x, sample: c ? chainOfMagic(c).map((m) => m.name).join(' → ') : '収録なし' };
});
const src = (S.src ?? []).filter((s, i, a) => a.findIndex((x) => x.url === s.url) === i);
---
<Base title={`${g.name}の魔法体系｜RPG魔法の言い換え辞典`} description={S.overview.slice(0, 110)} active="games" path={systemUrl(g.id)}
  crumbs={[{ name: 'トップ', path: '/' }, { name: '作品から探す', path: '/game' }, { name: `${g.name}の魔法体系`, path: systemUrl(g.id) }]}>
  <main class="wrap page chapters">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><a href="/game">作品から探す</a><span>›</span><span aria-current="page">{g.name}</span></nav>
    <p class="t-label" style="margin-top:20px">呼び方：{g.sys} ／ 収録 <span class="t-num">{count}</span>種</p>
    <h1 class="t-h1" style="margin-top:6px">{g.name}の魔法体系</h1>
    {g.basis && <p class="t-note" style="margin-top:8px">{g.basis}</p>}
    {S.verdict && <p class="verdict"><span class="t-label">収録の判断</span><br />{S.verdict}</p>}

    <section class="sec">
      <Chapter title="概要と命名のルール" />
      <div class="split">
        <p class="prose">{S.overview}</p>
        <div>
          <h3 class="t-label">命名のルール</h3>
          <ol class="nums">{S.rules.map((t, i) => <li><b>{String(i + 1).padStart(2, '0')}</b><span>{t}</span></li>)}</ol>
          {S.growth && S.growth.length > 0 && (
            <>
              <h3 class="t-label" style="margin-top:20px">強化・派生のルール</h3>
              <ol class="nums">{S.growth.map((t, i) => <li><b>{String(i + 1).padStart(2, '0')}</b><span>{t}</span></li>)}</ol>
            </>
          )}
        </div>
      </div>
    </section>

    {S.categories && S.categories.length > 0 && (
      <section class="sec">
        <Chapter title={`${g.sys}の分類`} />
        <div class="cats">{S.categories.map((c) => <div><b>{c.name}</b><p>{c.desc}</p></div>)}</div>
      </section>
    )}

    {elements.length > 0 && (
      <section class="sec">
        <Chapter title="属性の呼び名" note="押すと属性ごとの比較へ" />
        <div class="eln">
          {elements.map(({ e, local }) => (
            <div><a href={`/element/${e.id}`} style={`color:${elInk(e)}`}>{e.name}属性</a><b>{local ?? e.name}</b></div>
          ))}
        </div>
      </section>
    )}

    {sections.map((s) => (
      <section class="sec">
        <Chapter title={s.title} note={`${s.n}種`} />
        <div class="sys-rows">
          {s.groups.map((gp) => (
            <div>
              <span class="sys-rows__lbl" style={gp.el ? `color:${elInk(gp.el)}` : undefined}>{gp.label}</span>
              <div>{gp.lines.map((ln) => <Chain line={ln} />)}</div>
            </div>
          ))}
        </div>
      </section>
    ))}

    {siblings.length > 1 && (
      <section class="sec">
        <Chapter title={`${g.series ?? 'シリーズ'}の各作品`} note="作品ごとに命名や分類が少しずつ違います" />
        <p class="inline-links">
          {siblings.map((x) => <a href={systemUrl(x.id)} aria-current={x.id === g.id ? 'page' : undefined}>{x.short}{!x.group && '（代表）'}</a>)}
        </p>
      </section>
    )}

    <section class="sec">
      <Chapter title="他の作品の魔法体系" />
      <div class="rows rows--top">
        {otherGames.map(({ x, sample }) => (
          <a class="row-link" href={systemUrl(x.id)}>
            <span class="row-link__game">{x.name}</span>
            <span class="row-link__chain">{sample}</span>
          </a>
        ))}
      </div>
    </section>

    {src.length > 0 && (
      <section class="src" aria-labelledby="src-h">
        <h2 id="src-h">出典</h2>
        <ul>{src.map((x) => <li><a href={x.url} rel="nofollow noopener" target="_blank">{x.title}</a></li>)}</ul>
      </section>
    )}
    <p class="t-note" style="margin-top:32px">※ 魔法名・分類・系統は攻略資料などで確認して掲載していますが、作品・版によって表記や仕様が異なる場合があります。</p>
  </main>
</Base>
