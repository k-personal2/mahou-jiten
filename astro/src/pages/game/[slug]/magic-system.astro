---
import Base from '../../../layouts/Base.astro';
import Chapter from '../../../components/Chapter.astro';
import Chain from '../../../components/Chain.astro';
import NameLine from '../../../components/NameLine.astro';
import BuyBox from '../../../components/BuyBox.astro';
import {
  GAMES, REP_GAMES, seriesGames, groupOf, EL, MAGICS, SYSTEMS, buildGroups, elnOf, markStyle, systemUrl, chainOfMagic, type Game,
  STAGES, stageTypeById, scopeTypeById, stageTypeUrl, BLUEPRINT_TIER_URL, releaseDate,
} from '../../../lib/dict';

export function getStaticPaths() {
  return GAMES.filter((g) => SYSTEMS[g.id]).map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Game };
const S = SYSTEMS[g.id];
const count = MAGICS.filter((m) => m.game === g.id).length;
const SECS: [string, string[]][] = [
  ['攻撃魔法', ['atk']], ['回復魔法', ['heal']], ['補助魔法', ['atkup', 'defup', 'spdup']], ['弱体魔法', ['atkdown', 'defdown', 'spddown']],
  ['状態異常・即死', ['ailment', 'death']], ['治療・蘇生', ['cure', 'revive']], ['防御・移動・その他', ['barrier', 'field', 'misc']],
];
const sections = SECS.map(([title, fl]) => {
  const groups = buildGroups(g.id, fl);
  const n = groups.reduce((a, gp) => a + gp.lines.reduce((b, l) => b + l.items.length, 0), 0);
  return { title, groups, n };
}).filter((s) => s.groups.length);
const elements = EL.filter((e) => MAGICS.some((m) => m.game === g.id && m.el === e.id)).map((e) => ({ e, local: elnOf(g.id, e.id) }));
const siblings = seriesGames(g.id).filter((x) => SYSTEMS[x.id]);
const otherGames = REP_GAMES.filter((x) => x.id !== groupOf(g.id) && SYSTEMS[x.id] && MAGICS.some((m) => m.game === x.id)).map((x) => {
  const c = MAGICS.find((m) => m.game === x.id && m.fx === 'atk' && m.el === 'fire') ?? MAGICS.find((m) => m.game === x.id && m.fx === 'atk') ?? MAGICS.find((m) => m.game === x.id);
  return { x, sample: c ? chainOfMagic(c).map((m) => m.name).join(' → ') : '収録なし' };
});
const ST = STAGES[g.id];
const R = g.release;
const src = [...(S.src ?? []), ...(R?.src ?? [])].filter((s, i, a) => a.findIndex((x) => x.url === s.url) === i);
// シリーズ単位の代表（DQ）は発売日がシリーズ第1作のものなので、ゲーム1本としては示さない
const isSeries = g.name.endsWith('（シリーズ）');
// 作品の魔法体系を、魔法ページ（DefinedTerm）がまとまる語彙集として示す
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: `${g.name}の魔法体系`, description: S.overview,
  url: new URL(systemUrl(g.id), Astro.site ?? Astro.url).href, inLanguage: 'ja',
  ...(R && !isSeries ? { about: { '@type': 'VideoGame', name: g.name, datePublished: R.date, gamePlatform: R.platforms } } : {}),
}];
---
<Base title={`${g.name}の魔法体系｜RPG魔法辞典`} description={S.overview.slice(0, 110)} active="games" path={systemUrl(g.id)} jsonld={jsonld}
  crumbs={[{ name: 'トップ', path: '/' }, { name: '作品から探す', path: '/game' }, { name: `${g.name}の魔法体系`, path: systemUrl(g.id) }]}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><a href="/game">作品から探す</a><span>›</span><span>{g.name}</span><span>›</span><span aria-current="page">魔法体系</span></nav>
    <div class="p-meta"><span class="lbl">呼び方：{g.sys} ・ 収録 {count}種</span><span class="url">{systemUrl(g.id)}</span></div>
    <h1 class="p-title is-kicker">{g.name}の魔法体系</h1>
    {(R || g.basis) && (
      <div class="p-notes">
        {R && <p>最初の発売：<time datetime={R.date}>{releaseDate(R)}</time>（{R.platforms.join('・')}）{R.note && `。${R.note.replace(/。$/, '')}`}</p>}
        {g.basis && <p>収録の基準：{g.basis}</p>}
      </div>
    )}
    {S.verdict && <div class="card verdict"><span class="lbl">収録の判断</span><p>{S.verdict}</p></div>}

    <div class="two" style="margin-top:20px">
      <div class="card box"><h2 class="lbl">概要</h2><p class="prose prose-lg">{S.overview}</p></div>
      <div>
        <div class="card box">
          <h2 class="lbl">命名のルール</h2>
          <ol class="rules">{S.rules.map((t, i) => <li><b>{String(i + 1).padStart(2, '0')}</b><span>{t}</span></li>)}</ol>
        </div>
        {S.growth && S.growth.length > 0 && (
          <div class="card box">
            <h2 class="lbl">強化・派生のルール</h2>
            <ol class="rules">{S.growth.map((t, i) => <li><b>{String(i + 1).padStart(2, '0')}</b><span>{t}</span></li>)}</ol>
          </div>
        )}
      </div>
    </div>

    {ST && (
      <section class="sec">
        <Chapter title="段階の付け方" note="魔法世界の設計図">
          <a class="more" href={BLUEPRINT_TIER_URL}>作品を横断して比べる →</a>
        </Chapter>
        <div class="two">
          <div class="card sys-card">
            <div>
              <span class="lbl">段階</span>
              <p class="grp-head"><a class="min" style="font-size:20px" href={stageTypeUrl(ST.primary)}>{stageTypeById[ST.primary].name}</a></p>
              <p class="prose-sans">{ST.desc}</p>
            </div>
            {ST.examples.slice(0, 2).map((e) => <NameLine game={g.id} names={e.names} />)}
            <div class="sys-mini">
              <span class="lbl">範囲</span>
              <p class="grp-head">{scopeTypeById[ST.scope.type].name}</p>
              {ST.scope.desc && <p class="prose-sans">{ST.scope.desc}</p>}
              {ST.scope.examples.slice(0, 1).map((e) => <NameLine game={g.id} names={e} />)}
            </div>
          </div>
          {(ST.diff || ST.insight) && (
            <div class="card box">
              {ST.diff && (<><span class="lbl">シリーズ内の違い</span><p class="prose">{ST.diff}</p></>)}
              {ST.insight && (<><span class="lbl" style={ST.diff ? 'display:block;margin-top:16px' : undefined}>このサイトの見方</span><p class="prose">{ST.insight}</p></>)}
            </div>
          )}
        </div>
      </section>
    )}

    {S.categories && S.categories.length > 0 && (
      <section class="sec">
        <Chapter title={`${g.sys}の分類`} />
        <div class="og-grid">{S.categories.map((c) => <div class="card og"><span class="min">{c.name}</span><p>{c.desc}</p></div>)}</div>
      </section>
    )}

    {elements.length > 0 && (
      <section class="sec">
        <Chapter title="属性体系" note="作品内での属性の呼び名。押すと横断比較へ" />
        <div class="el-names">
          {elements.map(({ e, local }) => (
            <a href={`/element/${e.id}`}><span class="mark" style={markStyle(e, 28)} aria-hidden="true">{e.name}</span><span class="min">{local ?? e.name}</span>{local && <small>＝{e.name}属性</small>}</a>
          ))}
        </div>
      </section>
    )}

    {sections.map((s) => (
      <section class="sec">
        <Chapter title={s.title} note={`${s.n}種`} />
        <div class="card sys-table">
          {s.groups.map((gp) => (
            <div class="sys-row">
              <div class="grp-head"><span class="mark" style={markStyle(gp.el, 24)} aria-hidden="true">{gp.mark}</span>{gp.label}</div>
              <Chain lines={gp.lines} />
            </div>
          ))}
        </div>
      </section>
    ))}

    {siblings.length > 1 && (
      <section class="sec">
        <Chapter title={`${g.series ?? 'シリーズ'}の各作品`} note="作品ごとに命名や分類が少しずつ違います" />
        <div class="chips">
          {siblings.map((x) => <a class="chip" href={systemUrl(x.id)} aria-current={x.id === g.id ? 'page' : undefined}>{x.short}{!x.group && '（代表）'}</a>)}
        </div>
      </section>
    )}

    {g.shop && g.shop.length > 0 && (
      <section class="sec">
        <Chapter title="この作品を遊ぶ" note="PR" />
        <div class="buys">{g.shop.map((x) => <BuyBox game={g} item={x} />)}</div>
        <p class="note" style="margin-top:8px">Amazonのアソシエイトとして、RPG魔法辞典は適格販売により収入を得ています。</p>
      </section>
    )}

    <section class="sec">
      <Chapter title="他の作品の魔法体系" />
      <div class="og-grid">
        {otherGames.map(({ x, sample }) => <a class="card og" href={systemUrl(x.id)}><b>{x.name}</b><span class="min">{sample}</span></a>)}
      </div>
    </section>

    {src.length > 0 && (
      <section class="sec" aria-labelledby="src-h">
        <Chapter id="src-h" title="出典" />
        <ul class="src-list">{src.map((x) => <li><a href={x.url} rel="nofollow noopener" target="_blank">{x.title}</a></li>)}</ul>
      </section>
    )}
    <p class="disclaimer">※ 魔法名・分類・系統は攻略資料などで確認して掲載していますが、作品・版によって表記や仕様が異なる場合があります。</p>
  </main>
</Base>
