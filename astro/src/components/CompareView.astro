---
import Base from '../layouts/Base.astro';
import Chapter from './Chapter.astro';
import FilterBar from './FilterBar.astro';
import {
  EL, FX, SYSTEMS, elById, fxById, kindName, titleOf, subOf, compareRows, firstNames, rowsTotal,
  tone, markStyle, magicUrl, systemUrl, compareUrl,
} from '../lib/dict';
interface Props { el: string | null; fx: string }
const { el, fx } = Astro.props;
const E = el ? elById[el] : null, F = fxById[fx];
const title = titleOf(el, fx);
const rows = compareRows(el, fx);
const total = rowsTotal(rows);
const nGames = new Set(rows.map((r) => r.g.id)).size;
const names = firstNames(rows);
const top3 = names.slice(0, 3).map((n) => n.name);

// 作品ごとのカード：系統の最初の名前を大きく。長い名前は文字を小さくする
const cards = rows.map(({ g, list, kind }) => {
  const b = list[0], L = [...b.name].length;
  return { g, b, kn: kindName(fx, kind), sys: subOf(b), k: L <= 4 ? 1 : L <= 6 ? 0.84 : L <= 9 ? 0.7 : 0.56, rest: list.slice(1) };
});

// 段階対応表の列数
const n = Math.max(3, ...rows.map((r) => r.list.length));
const cols = [...Array(n).keys()];
const gaugeColor = tone(E).ink;

// 作品の中での属性の呼び名（同じ呼び名の作品をまとめる）
const elNames = (() => {
  if (!el) return [];
  const m = new Map<string, string[]>();
  rows.forEach(({ g }) => {
    const local = SYSTEMS[g.id]?.elementNames?.[el];
    if (local && !m.get(local)?.includes(g.short)) m.set(local, [...(m.get(local) ?? []), g.short]);
  });
  return [...m].map(([local, games]) => ({ local, games }));
})();

// ほかの比較：属性ページは次の属性2つ＋回復、用途ページは次の用途3つ
const sample = (e: string | null, f: string) => firstNames(compareRows(e, f)).slice(0, 4).map((x) => x.name).join(' ／ ');
const related = (el
  ? [...EL.filter((e) => e.id !== 'none'), ...EL.filter((e) => e.id !== 'none')].slice(EL.findIndex((e) => e.id === el) + 1).slice(0, 2).map((e) => ({ e: e.id as string | null, f: 'atk' })).concat(fx === 'heal' ? [] : [{ e: null, f: 'heal' }])
  : [...FX, ...FX].slice(FX.findIndex((f) => f.id === fx) + 1).filter((f) => f.id !== 'atk').slice(0, 3).map((f) => ({ e: null as string | null, f: f.id }))
).map(({ e, f }) => ({ title: `${titleOf(e, f)}の言い換え一覧`, href: compareUrl(e, f), ex: sample(e, f) })).filter((x) => x.ex);

const what = E ? `${E.id === 'none' ? '無属性' : E.name}の${F.name}魔法` : `${F.name}魔法`;
const desc = rows.length
  ? `${title}を${nGames}作品で比較。${names.slice(0, 3).map((x) => `${x.name}（${x.games[0].short}）`).join('、')}など${names.length}通りの呼び名と、作品ごとの段階（系統）の違いが分かります。`
  : `${title}を作品ごとに比較します。`;
---
<Base title={`${title}の言い換え一覧（${nGames}作品・${names.length}通り）｜RPG魔法辞典`} description={desc} active="compare" path={compareUrl(el, fx)}
  crumbs={[{ name: 'トップ', path: '/' }, { name: title, path: compareUrl(el, fx) }]}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><span>横断比較</span><span>›</span><span aria-current="page">{title}</span></nav>

    <header class="cmp-head">
      <span class="mark" style={markStyle(E, 72)} aria-hidden="true">{E ? E.name : F.kanji}</span>
      <div>
        <h1><span class="lbl cmp-kicker">{title}の言い換え一覧</span><span class="cmp-h1">{what}、<br />ゲームによってこんなに違う。</span></h1>
        <p class="lbl">{nGames}作品 · {total}件</p>
        {rows.length > 0 && <p class="cmp-lead">{top3.join('、')}。{nGames}作品の{title}を、{names.length}通りの呼び名で読み比べ。カードは各作品の系統の最初の名前です。</p>}
      </div>
    </header>

    <FilterBar el={el} fx={fx} />

    {rows.length === 0 ? (
      <div class="empty"><strong>この組み合わせの魔法はまだ収録されていません</strong><p>別の属性・用途を選んでください。</p></div>
    ) : (
      <>
        <section class="cards" aria-label="作品ごとの呼び名">
          {cards.map((c) => (
            <a class="card cmp-card" href={magicUrl(c.b)}>
              <span class="cmp-card-top"><span class="cmp-game">{c.g.name}{c.kn && `・${c.kn}`}</span><span class="tag dot">{c.sys}</span></span>
              <span class="cmp-name" style={`--k:${c.k}`}>{c.b.name}</span>
              <span class="cmp-rest">{c.rest.length ? '› ' + c.rest.map((r) => r.name).join(' › ') : 'この系統はこの1種'}</span>
            </a>
          ))}
        </section>

        <section class="sec pc-only">
          <Chapter title="段階対応表" note="各作品の系統の中で何段目か。威力の厳密な一致ではありません" />
          <div class="card others tbl-wrap" style={`--g:${gaugeColor}`}>
            <table class="tbl mx" aria-label={`${title}の段階対応表`}>
              <thead>
                <tr>
                  <th scope="col">作品</th><th scope="col">分類</th>
                  {cols.map((i) => (
                    <th scope="col"><span class="mx-th"><span class="gauge" aria-hidden="true">{cols.map((j) => <i class:list={{ on: j <= i }}></i>)}</span>{i + 1}段目</span></th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map(({ g, list, kind }, ri) => (
                  <tr data-more-item={ri >= 16 ? 'mx' : undefined} hidden={ri >= 16}>
                    <th scope="row"><a class="mx-game" href={systemUrl(g.id)}>{g.name}</a></th>
                    <td><span class="tag">{subOf(list[0])}{kindName(fx, kind) && `・${kindName(fx, kind)}`}</span></td>
                    {cols.map((i) => (
                      <td>{list[i] ? <a class="mx-cell" href={magicUrl(list[i])}><span class="min">{list[i].name}</span><small>{list[i].scope}</small></a> : <span class="mx-none">—</span>}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {rows.length > 16 && <button class="btn btn-line btn-more" type="button" data-more="mx" data-less="16系統に戻す" aria-expanded="false">残り{rows.length - 16}系統を表示（全{rows.length}系統）</button>}
        </section>

        {E && elNames.length > 0 && (
          <section class="sec">
            <Chapter title={`作品の中では、${E.name}をどう呼ぶ？`} />
            <p class="sec-intro">サイトでは共通の「{E.name}」にまとめていますが、作品の中の分類はそろっていません。作品の呼び名をそのまま載せます。</p>
            <div class="el-names">
              {elNames.map((x) => <div><span class="mark" style={markStyle(E, 28)} aria-hidden="true">{E.name}</span><span class="min">{x.local}</span><small>{x.games.join('・')}</small></div>)}
            </div>
          </section>
        )}
      </>
    )}

    {related.length > 0 && (
      <section class="sec">
        <Chapter title="ほかの言い換えも比べる" />
        <div class="og-grid">
          {related.map((x) => <a class="card og" href={x.href}><b>{x.title}</b><span class="min">{x.ex}</span></a>)}
        </div>
      </section>
    )}
  </main>
</Base>
