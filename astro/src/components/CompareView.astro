---
import Base from '../layouts/Base.astro';
import FilterBar from './FilterBar.astro';
import { GAMES, elById, fxById, chainsOf, kindName, titleOf, subOf, tone, markStyle, magicUrl, systemUrl, compareUrl, type Magic, type Game } from '../lib/dict';
interface Props { el: string | null; fx: string }
const { el, fx } = Astro.props;
const E = el ? elById[el] : null, F = fxById[fx];
// 1行＝1系統。細分類（眠り・毒など）がある用途は細分類ごとにまとめる
type Row = { g: Game; list: Magic[]; kind: string | null };
const all: Row[] = GAMES.flatMap((g) => chainsOf(g.id, el, fx).map((c) => ({ g, list: c.list, kind: c.kind })));
const kindOrder = Object.keys(F.kinds ?? {});
// 細分類なし（＝その用途の基本形）→ 定義順の細分類 → 未定義
// 細分類が主の用途（状態異常など）では細分類なしを末尾の「その他」に、そうでなければ先頭（基本形）に
const kinded = all.filter((r) => r.kind).length > all.length / 2;
const rank = (k: string | null) => (!k ? (kinded ? kindOrder.length + 1 : -1) : kindOrder.includes(k) ? kindOrder.indexOf(k) : kindOrder.length);
const rows = [...all].sort((a, b) => rank(a.kind) - rank(b.kind));
const nGames = new Set(rows.map((r) => r.g.id)).size;
const total = rows.reduce((a, r) => a + r.list.length, 0);
const title = titleOf(el, fx);
const toCard = ({ g, list }: Row) => {
  const b = list[0], L = [...b.name].length;
  return { g, b, sys: subOf(b), k: L <= 4 ? 1 : L <= 6 ? 0.84 : 0.7, rest: list.slice(1) };
};
const groups: { label: string | null; cards: ReturnType<typeof toCard>[] }[] = [];
rows.forEach((r) => {
  const label = kindOrder.length ? kindName(fx, r.kind) ?? (r.kind || kinded ? 'その他' : F.phrase) : null;
  const gp = groups.find((x) => x.label === label) ?? (groups.push({ label, cards: [] }), groups[groups.length - 1]);
  gp.cards.push(toCard(r));
});
const nNames = new Set(rows.map((r) => r.list[0].name)).size;
const cols = [...Array(Math.max(4, ...rows.map((r) => r.list.length))).keys()];
const desc = E ? `${E.phrase.replace('を使った', '')}による攻撃魔法を、ゲーム作品ごとに比較します。` : `${F.phrase}魔法を、ゲーム作品ごとに比較します。`;
const gaugeColor = tone(E).ink;
---
<Base title={`${title}の言い換え一覧｜RPG魔法の言い換え辞典`} description={desc} active="compare" path={compareUrl(el, fx)}>
  <main class="wrap page">
    <nav class="crumbs" aria-label="パンくず"><a href="/">トップ</a><span>›</span><span>横断比較</span><span>›</span><span aria-current="page">{title}</span></nav>

    <header class="cmp-head">
      <span class="mark" style={markStyle(E, 72)}>{E ? E.name : F.kanji}</span>
      <div>
        <p class="lbl">{title} ・ {nGames}作品 · {total}件</p>
        <h1 class="cmp-h1">{E ? E.name + 'の' : ''}{F.name}魔法、<br />ゲームによってこんなに違う。</h1>
        {rows.length > 0 && <p class="cmp-lead">同じ役割の魔法を作品ごとに読み比べ。{nGames}作品で{nNames}通りの呼び名があります。</p>}
      </div>
    </header>

    <FilterBar el={el} fx={fx} />

    {rows.length === 0 ? (
      <div class="empty"><strong>この組み合わせの魔法はまだ収録されていません</strong><p>別の属性・用途を選んでください。</p></div>
    ) : (
      <>
        {groups.map((gp) => (
          <section class="cmp-group" aria-label={gp.label ?? '作品ごとの呼び名'}>
            {gp.label && <h2 class="h2 cmp-kind">{gp.label}</h2>}
            <div class="cards">
              {gp.cards.map((c) => (
                <a class="card cmp-card" href={magicUrl(c.b)}>
                  <span class="cmp-card-top"><span class="cmp-game">{c.g.name}</span><span class="tag dot">{c.sys}</span></span>
                  <span class="cmp-name" style={`--k:${c.k}`}>{c.b.name}</span>
                  <span class="cmp-rest">{c.rest.length ? '› ' + c.rest.map((r) => r.name).join(' › ') : 'この系統はこの1種'}</span>
                </a>
              ))}
            </div>
          </section>
        ))}

        <section class="sec pc-only">
          <div class="sec-head">
            <h2 class="h2">段階対応表</h2>
            <span class="note">各作品の系統内での段階。威力の厳密な一致ではありません</span>
          </div>
          <div class="card matrix" style={`--g:${gaugeColor};--cols:${cols.length}`}>
            <div class="mx-row mx-head">
              <span>作品</span><span>分類</span>
              {cols.map((i) => (
                <span class="mx-th"><span class="gauge">{cols.map((j) => <i class:list={{ on: j <= i }}></i>)}</span>{i + 1}段目</span>
              ))}
            </div>
            {rows.map(({ g, list, kind }) => (
              <div class="mx-row">
                <a class="mx-game" href={systemUrl(g.id)}>{g.name}{kindName(fx, kind) && <small class="mx-kind">{kindName(fx, kind)}</small>}</a>
                <span><span class="tag">{subOf(list[0])}</span></span>
                {cols.map((i) => list[i]
                  ? <a class="mx-cell" href={magicUrl(list[i])}><span class="min">{list[i].name}</span><small>{list[i].scope}</small></a>
                  : <span class="mx-none">—</span>)}
              </div>
            ))}
          </div>
        </section>
      </>
    )}
  </main>
</Base>
