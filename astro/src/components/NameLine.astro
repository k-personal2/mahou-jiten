---
/** 作品内の魔法名の並び。同じ系統で段階順なら →、そうでなければ ／ でつなぐ */
import Chain from './Chain.astro';
import { L, type Lang } from '../lib/i18n';
interface Props { game: string; names: string[]; class?: string; lang?: Lang }
const { game, names, class: cls, lang = 'ja' } = Astro.props;
const line = L(lang).line(game, names);
---
<Chain lines={[line]} class:list={['chain-sm', cls]} sep={line.linked ? '→' : '／'} />
