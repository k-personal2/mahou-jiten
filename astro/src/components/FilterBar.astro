---
import { EL, FX, markStyle } from '../lib/dict';
import { L, type Lang } from '../lib/i18n';
interface Props { el: string | null; fx: string; lang?: Lang }
const { el, fx, lang = 'ja' } = Astro.props;
const t = L(lang);
---
<nav class="filters" aria-label={t.en ? 'Filter by element and effect' : '属性・用途で絞り込み'}>
  <div>
    <span class="lbl">{t.en ? 'Element' : '属性'}</span>
    {EL.map((e) => (
      <a class="chip" href={t.url(`/element/${e.id}`)} aria-current={fx === 'atk' && el === e.id ? 'page' : undefined}>
        <span class="mark" style={markStyle(e, 20)} aria-hidden="true">{e.name}</span>{t.el(e)}
      </a>
    ))}
  </div>
  <div>
    <span class="lbl">{t.en ? 'Effect' : '用途'}</span>
    {FX.map((f) => (
      <a class="chip" href={t.compare(el, f.id)} aria-current={fx === f.id ? 'page' : undefined}>{t.fx(f)}</a>
    ))}
  </div>
</nav>
