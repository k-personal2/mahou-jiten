// Cloudflare Workers（静的アセット配信）の設定。Worker のコードはなく dist/ をそのまま配信する
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahou-jiten",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    // /foo.html を /foo で配信する（astro.config の trailingSlash: 'never' と一致させる）
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
